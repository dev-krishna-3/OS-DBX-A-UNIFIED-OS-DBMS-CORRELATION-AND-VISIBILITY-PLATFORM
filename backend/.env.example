APP_NAME=OS-DBX Backend
ENVIRONMENT=development
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=os_dbx
EVENT_STORAGE=memory
DBMS_COLLECTION_INTERVAL_SECONDS=5

# Optional SMTP settings for auth email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
